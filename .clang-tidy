---
# CONVENTIONS.md §8 — C++17, sabit boyutlu Eigen, ham new/delete yok.
Checks: >
  bugprone-*,
  performance-*,
  readability-*,
  modernize-*,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-owning-memory,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -bugprone-easily-swappable-parameters
WarningsAsErrors: 'bugprone-*'
# Yola bagimli OLMAMALI. 'kerteriz.*' checkout yolu 'kerteriz' icerdiginde
# (CI'da /home/runner/work/kerteriz/kerteriz/...) build/_deps altindaki
# ucuncu taraf basliklariyla da eslesiyordu. Kaynak duzenine sabitlendi.
HeaderFilterRegex: '.*/kerteriz_(core|sim)/include/.*'
FormatStyle: file
